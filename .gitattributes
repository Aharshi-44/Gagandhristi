# ============================================================
# GAGANDHRISTI: GIT ATTRIBUTES & LFS CONFIGURATION
# ============================================================

# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Windows-specific scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf

# Explicit binary files (do not normalize line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.tar.gz binary
*.zip binary
*.rdb binary

# Large model weight checkpoints and vector embeddings (Git LFS)
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text

# Geospatial raster datasets
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
